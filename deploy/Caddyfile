{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# SITE_ADDRESS is the canonical hostname (automatic HTTPS), or `localhost` locally.
# REDIRECT_ADDRESSES are extra hostnames (www + previous public URL) that permanently
# redirect to SITE_ADDRESS, preserving the path. Space or comma separated; may be empty.
{$SITE_ADDRESS} {$REDIRECT_ADDRESSES} {
	@redirect {
		not host {$SITE_ADDRESS}
	}
	redir @redirect https://{$SITE_ADDRESS}{uri} permanent

	encode zstd gzip

	request_body {
		max_size 256KB
	}

	header {
		-Server
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Health and readiness stay internal.
	@internal path /readyz
	respond @internal 404

	reverse_proxy server:8080 {
		health_uri /healthz
		health_interval 15s
	}

	log {
		output stdout
		format json
	}
}
