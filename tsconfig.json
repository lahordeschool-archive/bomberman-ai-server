{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/server/test/**/*.ts",
    "apps/bot-runner/src/**/*.ts",
    "apps/bot-runner/test/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ]
}
