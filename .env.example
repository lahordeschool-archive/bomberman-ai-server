# Copy to .env and fill in. Never commit .env.

# Public URL players use. Must match what the browser shows (scheme + host + port).
PUBLIC_ORIGIN=https://bomber-arena.com
# Hostname Caddy serves and fetches a TLS certificate for. Use `localhost` to try locally.
SITE_ADDRESS=bomber-arena.com
# Extra hostnames that permanently redirect to SITE_ADDRESS / PUBLIC_ORIGIN (path preserved).
# Always include www. Add your previous Coolify / sslip.io hostname for old bookmarks.
REDIRECT_ADDRESSES=www.bomber-arena.com
REDIRECT_HOSTS=www.bomber-arena.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
RUNNER_TOKEN=
# Optional initial password for the reserved Sharkey administrator (12+ characters).
# It is applied only while the account is disabled; later password changes are preserved.
SHARKEY_ADMIN_PASSWORD=

LOG_LEVEL=info
RANKED_CONCURRENCY=2
RUNNER_WORKERS=2
RUNNER_CPUS=2
BOT_MEMORY_MB=32
# Bots may call public HTTP APIs (private and internal addresses are always refused).
BOT_FETCH=on
