{
  "name": "bomberman-ai-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Competitive Bomberman platform where players write the AI that controls their bomber.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n runner,server,web -c yellow,cyan,magenta \"npm run dev -w @bomberman/bot-runner\" \"npm run dev -w @bomberman/server\" \"npm run dev -w @bomberman/web\"",
    "build": "npm run build -w @bomberman/web",
    "start": "npm run start -w @bomberman/server",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "npm run db:migrate -w @bomberman/server",
    "ratings:rebuild": "npm run ratings:rebuild -w @bomberman/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
